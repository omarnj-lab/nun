# Copy to .env on the server (never commit .env)
ANTHROPIC_API_KEY=            # chat agent + router + vision baseline (model: claude-opus-5)
HF_TOKEN=                     # read base models; write to NAMAA-Space for releases
KAGGLE_USERNAME=              # to pull the KhaṭṭVision v1 notebook (or download it manually)
KAGGLE_KEY=
PUBLIC_BASE_URL=              # e.g. https://nun.example.com (used by the web app + CORS)
WEB_ORIGIN=                   # the web app origin allowed by CORS
REFERRAL_CONTACT_AR=          # shown by refer_to_human (e.g. the mosque/museum guide desk, or a helpline)
REFERRAL_CONTACT_EN=
GPU_TIER=auto                 # auto | a80 | a48 | a24 (see SPEC.md §6.4)
VLM_ADAPTER=NAMAA-Space/KhattVision-Muse-Glimmer-30B-LoRA   # switch to the v2 adapter after M9
LOG_LEVEL=info
