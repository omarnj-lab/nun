# Copy to .env on the server (never commit .env).
# Keep comments on their own lines: an inline comment after an empty value is read AS the value.

# chat agent + router + vision baseline (model: claude-opus-5)
ANTHROPIC_API_KEY=
# read base models; write to NAMAA-Space for releases
HF_TOKEN=
# to pull the KhaṭṭVision v1 notebook (optional: the notebook is public)
KAGGLE_USERNAME=
KAGGLE_KEY=
# e.g. https://nun.example.com (used by the web app + CORS)
PUBLIC_BASE_URL=
# the web app origin allowed by CORS
WEB_ORIGIN=
# shown by refer_to_human (e.g. the mosque/museum guide desk, or a helpline)
REFERRAL_CONTACT_AR=
REFERRAL_CONTACT_EN=
# auto | a80 | a48 | a24 (see SPEC.md §6.4)
GPU_TIER=auto
# switch to the v2 adapter after M9
VLM_ADAPTER=NAMAA-Space/KhattVision-Muse-Glimmer-30B-LoRA
LOG_LEVEL=info
