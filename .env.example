# Copy to .env on the server (never commit .env). Keep comments on their own lines.

# chat answers and the independent verse check (Claude)
ANTHROPIC_API_KEY=
# password for /admin (add panels to the collection)
ADMIN_PASSWORD=
# chat: answer model (anthropic | local), question router (local = Ollama), answer effort
CHAT_PROVIDER=anthropic
ROUTER_PROVIDER=local
ANSWER_EFFORT=low
# local model served by Ollama (router and fallback)
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.6:latest
# Nūn Vision weights
VLM_ADAPTER=Omartificial-Intelligence-Space/Nun-Vision-30B-Lora
# shown with the referral for personal rulings (e.g. the mosque or museum guide desk)
REFERRAL_CONTACT_AR=
REFERRAL_CONTACT_EN=
